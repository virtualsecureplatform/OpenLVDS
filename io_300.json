{
  "schema": "openlvds-io-300-v1",
  "status": "development_unqualified",
  "qualified_io": false,
  "scope": "Asynchronous LVDS driver and receiver hard macros; no clocking, serialization or training. Pads, ESD, package, termination, buffered VREF and one IREF sink per macro instance are external.",
  "macros": {
    "openlvds_io_tx": {
      "subckt": "openlvds_io_tx",
      "pins": ["D", "OUTP", "OUTN", "VREF", "IREF", "VDDIO", "VDDD", "VSS"]
    },
    "openlvds_io_rx": {
      "subckt": "openlvds_io_rx",
      "pins": ["INP", "INN", "Q", "VREF", "IREF", "VDDIO", "VDDD", "VSS"]
    }
  },
  "requirements": {
    "schema_version": 1,
    "lane_rate_mbps": 600,
    "nominal_clock_mhz": 300,
    "clock_test_mhz": [290, 300, 310],
    "bits_per_cycle": 2,
    "analog_supply_v": 3.3,
    "digital_supply_v": 1.8,
    "reference_v": 1.2,
    "reference_current_a": 3.5e-05,
    "supply_sweep": false,
    "temperatures_c": [0, 25, 40],
    "process_corners": ["tt", "ff", "ss", "fs", "sf"],
    "tx_level_qualification": "dc_100ohm",
    "tx_differential_min_v": 0.25,
    "tx_differential_max_v": 0.45,
    "tx_common_mode_min_v": 1.125,
    "tx_common_mode_max_v": 1.375,
    "tx_differential_imbalance_max_v": 0.05,
    "tx_common_mode_imbalance_max_v": 0.05,
    "tx_transition_20_80_min_ps": 260,
    "tx_transition_max_ui_fraction": 0.3,
    "tx_dynamic_common_mode_pp_max_v": 0.15,
    "tx_ring_fraction_max": 0.2,
    "tx_monotonic_20_80": true,
    "rx_threshold_v": 0.1,
    "rx_pin_min_v": 0,
    "rx_pin_max_v": 2.4,
    "rx_static_common_mode_v": [0.05, 0.2, 0.6, 1.2, 1.8, 2.35],
    "rx_rate_differential_v": 0.25,
    "rx_rate_common_mode_v": 1.2,
    "rx_minimum_valid_pulse_ps": 400,
    "rx_output_load_ff": [10, 50, 100, 200],
    "channel": {
      "differential_impedance_ohm": 100,
      "max_length_m": 0.2,
      "delay_ns": [0.1, 1.2],
      "series_resistance_per_leg_ohm": 1,
      "pad_capacitance_per_pin_pf": 2,
      "package_inductance_per_pin_nh": 1,
      "termination_ohm": 100
    },
    "link_pattern": "prbs7",
    "minimum_extracted_nominal_bits": 4096,
    "minimum_extracted_corner_bits": 512,
    "link_clock_mhz": [290, 310],
    "link_rx_pin_eye_min_v": 0.1,
    "link_rx_pin_eye_width_min_ui": 0.5,
    "link_output_valid_min_ps": 400,
    "mismatch": {
      "engine": "ngspice",
      "model_section_suffix": "_mm",
      "nominal_samples": 200,
      "corner_samples": 50,
      "sigma": 3,
      "rx_offset_bound_v": 0.1,
      "rule": "abs(mean) + sigma * std must stay inside every contract bound"
    },
    "device_terminal_span_max_v": {"01v8": 1.95, "g5v0d10v5": 5.5},
    "stress_measurement_guard_v": 0.02,
    "layout_aspect_ratio_max": 2.0,
    "pdk": "sky130A",
    "pdk_version": "1689ac3f2dc763876eaf967227c7dfe831b031ae"
  },
  "release_gates": [
    "model_compatibility",
    "numerical_refinement",
    "exact_rc_equivalence",
    "native_drc_lvs_rc",
    "device_stress",
    "analog_tx_rx_15pvt",
    "offset_and_mismatch",
    "async_link_eye",
    "antenna_density_erc",
    "timing_library_15pvt",
    "published_views_integration",
    "fresh_joint_rc_and_release"
  ],
  "reference": "ANSI/TIA/EIA-644-A-2001 sections 4.1.1 (VT 250-450 mV, delta VT <= 50 mV), 4.1.2 (VOS 1.125-1.375 V, delta VOS <= 50 mV), 4.1.4 (260 ps <= tr,tf <= 0.3 tui, ring within 20%), 4.1.5 (dynamic VOS <= 150 mVpp)"
}
