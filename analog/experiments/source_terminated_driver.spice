XTERM17 OUTP OUTN VSS sky130_fd_pr__res_high_po_0p35 w=0.35 l=1.25
XTERM18 OUTP OUTN VSS sky130_fd_pr__res_high_po_0p35 w=0.35 l=1.25
XTERM19 OUTP OUTN VSS sky130_fd_pr__res_high_po_0p35 w=0.35 l=1.25
XTERM20 OUTP OUTN VSS sky130_fd_pr__res_high_po_0p35 w=0.35 l=1.25
XTERM21 OUTP OUTN VSS sky130_fd_pr__res_high_po_0p35 w=0.35 l=1.25
.ends openlvds_driver_core_source_terminated
