XTERM6 OUTP OUTN VSS sky130_fd_pr__res_high_po_0p35 w=0.35 l=1.25
XTERM7 OUTP OUTN VSS sky130_fd_pr__res_high_po_0p35 w=0.35 l=1.25
XTERM8 OUTP OUTN VSS sky130_fd_pr__res_high_po_0p35 w=0.35 l=1.25
XTERM9 OUTP OUTN VSS sky130_fd_pr__res_high_po_0p35 w=0.35 l=1.25
XTERM10 OUTP OUTN VSS sky130_fd_pr__res_high_po_0p35 w=0.35 l=1.25
XTERM11 OUTP OUTN VSS sky130_fd_pr__res_high_po_0p35 w=0.35 l=1.25
XTERM12 OUTP OUTN VSS sky130_fd_pr__res_high_po_0p35 w=0.35 l=1.25
XTERM13 OUTP OUTN VSS sky130_fd_pr__res_high_po_0p35 w=0.35 l=1.25
