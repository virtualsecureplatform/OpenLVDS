.subckt lvds_pfd REF FB RESET_N PD_ENABLE UP DN ERR VDDD VSS QREF QFB QWIN
XCLR RESET_N PD_ENABLE VSS VSS VDDD VDDD ALLOW sky130_fd_sc_hd__and2_1
XAND UP DN VSS VSS VDDD VDDD BOTH sky130_fd_sc_hd__and2_4
XRST BOTH ALLOW VSS VSS VDDD VDDD CLEAR_B sky130_fd_sc_hd__and2b_4
XU REF VDDD CLEAR_B VSS VSS VDDD VDDD RU sky130_fd_sc_hd__dfrtp_4
XD FB VDDD CLEAR_B VSS VSS VDDD VDDD RD sky130_fd_sc_hd__dfrtp_4
XUPBUF RU VSS VSS VDDD VDDD UP sky130_fd_sc_hd__buf_8
XDNBUF RD VSS VSS VDDD VDDD DN sky130_fd_sc_hd__buf_8
XRB QREF VSS VSS VDDD VDDD RI sky130_fd_sc_hd__buf_8
XFB QFB VSS VSS VDDD VDDD FI sky130_fd_sc_hd__buf_8
XWB QWIN VSS VSS VDDD VDDD WM sky130_fd_sc_hd__buf_8
XWB2 WM VSS VSS VDDD VDDD WI sky130_fd_sc_hd__buf_8
XRI RI VSS VSS VDDD VDDD REFB sky130_fd_sc_hd__inv_4
XFI FI VSS VSS VDDD VDDD FBB sky130_fd_sc_hd__inv_4
XCMP RI FBB FI REFB VSS VSS VDDD VDDD RAW_N sky130_fd_sc_hd__a22oi_4
XDRV RAW_N VSS VSS VDDD VDDD RAW sky130_fd_sc_hd__inv_16
XMASK RAW WI VSS VSS VDDD VDDD ERR sky130_fd_sc_hd__and2_4
.ends lvds_pfd

.subckt openlvds_dll_core CLK RESET_N PD_ENABLE PH0 PH90 PH180 PH270 FB PHASE_BAD UP DN PB VDDIO VDDD VSS
XA CLK PD_ENABLE PH0 PH90 PH180 PH270 FB PD_REF PHASE_BAD UP DN ERR PB VDDIO VDDD VSS QREF QFB QWIN PD_REF PH180 PH90 openlvds_dll_analog
XPFD PD_REF PH180 RESET_N PD_ENABLE UP DN ERR VDDD VSS QREF QFB QWIN lvds_pfd
.ends openlvds_dll_core

.subckt openlvds_dll CLK RESET_N PD_ENABLE PH0 PH90 PH180 PH270 FB PHASE_BAD UP DN VREF IREF VDDIO VDDD VSS
XB IREF NB VDDIO VSS lvds_bias
XCORE CLK RESET_N PD_ENABLE PH0 PH90 PH180 PH270 FB PHASE_BAD UP DN IREF VDDIO VDDD VSS openlvds_dll_core
.ends openlvds_dll

* Released asynchronous I/O macros (io_300.json). Each is one hard macro with
* its own bias mirror: every instance needs its own 35 uA IREF sink.
.subckt openlvds_io_tx D OUTP OUTN VREF IREF VDDIO VDDD VSS
XTX D OUTP OUTN VREF IREF VDDIO VDDD VSS openlvds_driver
.ends openlvds_io_tx

.subckt openlvds_io_rx INP INN Q VREF IREF VDDIO VDDD VSS
XRX INP INN Q VREF IREF VDDIO VDDD VSS openlvds_receiver
.ends openlvds_io_rx
